# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# JWT Authentication
JWT_SECRET=ecommerce_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Stripe Sandbox Payment Keys (Test mode)
# Get keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_mock_or_replace_with_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_mock_or_replace_with_your_stripe_test_publishable_key

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
